# ===== CCRCC Calendar — орчны хувьсагчид =====
# Энэ файлыг .env.local (хөгжүүлэлт) эсвэл .env.production (продакшн) болгон хуулж утгуудыг тохируулна уу.
# .env.local ба .env.production нь git-д orohgүй (.gitignore).

# --- Өгөгдлийн сан (MySQL / MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=calendar_app          # Продакшнд root биш, тусдаа хэрэглэгч ашиглана уу
DB_PASSWORD=                  # Продакшнд ЗААВАЛ хүчтэй нууц үг тавина уу
DB_NAME=calendar

# --- Анхны админ (зөвхөн эхний удаа автоматаар үүсгэнэ) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me      # Продакшнд ЗААВАЛ өөрчилнө үү (анхдагч admin12345-ыг битгий ашиглаарай)

# --- Сервер ---
PORT=3000
NODE_ENV=development          # Продакшнд: production
BODY_LIMIT=40mb               # HTTP body-ийн дээд хэмжээ (файл хавсралтын лимит)
